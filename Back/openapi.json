{
  "openapi": "3.0.0",
  "paths": {
    "/departuresRT": {
      "get": {
        "operationId": "DeparturesController_departuresRT",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeparturesResponseDto"
                  }
                }
              }
            }
          },
          "503": {
            "description": "GTFS-RT feed could not be fetched"
          }
        },
        "summary": "Realtime departures for both configured directions (GTFS-RT)",
        "tags": [
          "departures"
        ]
      }
    },
    "/departuresRT/{id}": {
      "get": {
        "operationId": "DeparturesController_departuresRTById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Line id",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeparturesResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Line not found"
          },
          "503": {
            "description": "GTFS-RT feed could not be fetched"
          }
        },
        "summary": "Realtime departures for one line (GTFS-RT)",
        "tags": [
          "departures"
        ]
      }
    },
    "/departures": {
      "get": {
        "operationId": "DeparturesController_departuresAll",
        "parameters": [
          {
            "name": "dateFrom",
            "required": false,
            "in": "query",
            "description": "Start of the departures window (ISO 8601). Defaults to one hour ago.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeparturesResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Scheduled departures for all configured lines, merged with the default realtime source",
        "tags": [
          "departures"
        ]
      }
    },
    "/departures/{id}": {
      "get": {
        "operationId": "DeparturesController_departuresById[0]",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Line id",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "dateFrom",
            "required": false,
            "in": "query",
            "description": "Start of the departures window (ISO 8601). Defaults to one hour ago.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "typeFetch",
            "required": false,
            "in": "path",
            "description": "Realtime source used to enrich the scheduled data",
