# Copy to .env next to docker-compose.yaml — Compose picks it up automatically.
# Shell environment variables take precedence over values defined here.

# Required
SNCF_API_KEY=

# Optional overrides (defaults are set in docker-compose.yaml)
#SNCF_API_URL=https://api.sncf.com/v1
#SNCF_GTFSRT_URL=https://proxy.transport.data.gouv.fr/resource/sncf-ter-gtfs-rt-trip-updates

# Optional features — endpoints needing them return 503 when unset
#SNCF_API_PRIM_URL=
#SNCF_API_PRIM_KEY=
#SNCF_CRAWL_URL=
#FLARE_API_URL=
#SNCF_CRAWL_FLARE_URL=

# Tuning
#REDIS_CRAWL_EXPIRE=300
#DEFAULT_FETCH_RT_METHOD=crawlFlare
#AWTRIX_ICON_TER=59998
#AWTRIX_ICON_RER=59997
